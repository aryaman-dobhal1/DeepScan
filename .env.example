# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Database
DATABASE_URL=sqlite+aiosqlite:///./deepscan.db

# CORS - comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# ML Models - paths to downloaded weights (Step 3 will populate these)
MODEL_DIR=./models
EFFICIENTNET_WEIGHTS=./models/efficientnet_b7_deepfake.pth
XCEPTION_WEIGHTS=./models/xception_deepfake.pth

# File upload limits
MAX_FILE_SIZE_MB=100
UPLOAD_DIR=./uploads

# API rate limiting
RATE_LIMIT_PER_MINUTE=30
